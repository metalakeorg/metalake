"""What Rust gives Python, for editors and type checkers. Nothing runs this: `stubtest` holds it to the library."""

import datetime
import os
from collections.abc import Iterator
from pathlib import Path
from typing import Literal, Protocol, TypeAlias, final, overload

import pandas
import polars
import pyarrow

__version__: str


class _ArrowStream(Protocol):
    """Anything that hands over a table through Arrow's C interface, as Polars, pandas and pyarrow do."""

    def __arrow_c_stream__(self, requested_schema: object = ...) -> object: ...


class _ArrowArray(Protocol):
    """Anything that hands over one batch through Arrow's C interface."""

    def __arrow_c_array__(self, requested_schema: object = ...) -> object: ...


_ArrowData: TypeAlias = _ArrowStream | _ArrowArray
_StrPath: TypeAlias = str | os.PathLike[str]
_Age: TypeAlias = str | datetime.timedelta
_Idempotent: TypeAlias = tuple[str, int]
_TaskName: TypeAlias = Literal["times", "flush", "compact", "footers", "expire", "sweep", "orphans", "strays"]


def connect(lake: _StrPath | None = None, *, schema: str | None = None) -> Lake: ...
def init(catalog: _StrPath, warehouse: _StrPath | None = None, *, schema: str | None = None) -> Lake: ...
def migrate(lake: _StrPath | None = None, *, schema: str | None = None) -> Lake: ...
def stop(lake: _StrPath | None = None) -> Path: ...
def cli(args: list[str]) -> int: ...


@final
class Lake:
    def close(self) -> None: ...
    def __enter__(self) -> Lake: ...
    def __exit__(self, *_failure: object) -> None: ...
    def sql(self, text: str) -> Result: ...
    def table(self, name: str) -> Table: ...
    def refresh(self) -> None: ...
    def status(self) -> Status: ...
    def refs(self) -> list[Ref]: ...
    def branch(self, name: str, start: str | None = None) -> Ref: ...
    def tag(self, name: str, start: str | None = None) -> Ref: ...
    def delete_branch(self, name: str) -> None: ...
    def delete_tag(self, name: str) -> None: ...
    def retain(
        self,
        on: str,
        *,
        max_age: _Age | None = None,
        min_snapshots: int | None = None,
        min_seq: int | None = None,
    ) -> None: ...
    def grace(self, age: _Age) -> None: ...
    def maintain(
        self,
        task: _TaskName | None = None,
        *,
        on: str | None = None,
        table: str | None = None,
    ) -> list[Done]: ...
    def merge(
        self,
        branch: str,
        *,
        check: bool = False,
        tables: list[str] | None = None,
        split: bool = False,
        message: str | None = None,
        author: str | None = None,
    ) -> Merged: ...
    @overload
    def log(self, on: str = "main", *, limit: int = 20, table: None = None) -> list[Commit]: ...
    @overload
    def log(self, on: str = "main", *, limit: int = 20, table: str) -> list[Snapshot]: ...


@final
class Table:
    @property
    def name(self) -> str: ...
    @property
    def columns(self) -> list[str]: ...
    def append(
        self,
        data: _ArrowData,
        *,
        message: str | None = None,
        author: str | None = None,
        idempotent: _Idempotent | None = None,
    ) -> Written: ...
    def overwrite(
        self,
        data: _ArrowData,
        *,
        message: str | None = None,
        author: str | None = None,
        idempotent: _Idempotent | None = None,
    ) -> Written: ...
    def upsert(
        self,
        data: _ArrowData,
        on: list[str],
        *,
        message: str | None = None,
        author: str | None = None,
        idempotent: _Idempotent | None = None,
    ) -> Written: ...
    def delete(
        self,
        filter: str,
        *,
        message: str | None = None,
        author: str | None = None,
        idempotent: _Idempotent | None = None,
    ) -> Written: ...
    def __arrow_c_schema__(self) -> object: ...


@final
class Result:
    @property
    def columns(self) -> list[str]: ...
    def to_polars(self) -> polars.DataFrame: ...
    def to_arrow(self) -> pyarrow.Table: ...
    def to_pandas(self) -> pandas.DataFrame: ...
    def __iter__(self) -> Batches: ...
    def __arrow_c_schema__(self) -> object: ...
    def __arrow_c_stream__(self, requested_schema: object = None) -> object: ...


@final
class Batches(Iterator[Batch]):
    def __iter__(self) -> Batches: ...
    def __next__(self) -> Batch: ...


@final
class Batch:
    @property
    def num_rows(self) -> int: ...
    @property
    def num_columns(self) -> int: ...
    @property
    def columns(self) -> list[str]: ...
    def __arrow_c_schema__(self) -> object: ...
    def __arrow_c_array__(self, requested_schema: object = None) -> object: ...


@final
class Written:
    @property
    def commit(self) -> int | None: ...
    @property
    def rows(self) -> int: ...
    @property
    def applied(self) -> bool: ...
    @property
    def inserted(self) -> int: ...
    @property
    def updated(self) -> int: ...


@final
class Ref:
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def parent(self) -> str | None: ...
    @property
    def fork_seq(self) -> int | None: ...
    @property
    def created_seq(self) -> int: ...
    @property
    def protected(self) -> bool: ...


@final
class Commit:
    @property
    def seq(self) -> int: ...
    @property
    def committed_at(self) -> str | None: ...
    @property
    def author(self) -> str | None: ...
    @property
    def operation(self) -> str: ...
    @property
    def message(self) -> str | None: ...


@final
class Snapshot:
    @property
    def id(self) -> int: ...
    @property
    def parent(self) -> int | None: ...
    @property
    def operation(self) -> str | None: ...
    @property
    def committed_at(self) -> str | None: ...


@final
class Merged:
    @property
    def branch(self) -> str: ...
    @property
    def outcome(self) -> str: ...
    @property
    def commit(self) -> int | None: ...
    @property
    def merged(self) -> list[str]: ...
    @property
    def rebased(self) -> list[str]: ...


@final
class Done:
    @property
    def task(self) -> str: ...
    @property
    def on(self) -> str | None: ...
    @property
    def table(self) -> str | None: ...
    @property
    def result(self) -> int | None: ...


@final
class Status:
    @property
    def postgres(self) -> str | None: ...
    @property
    def local(self) -> str | None: ...
    @property
    def schema(self) -> str: ...
    @property
    def warehouse(self) -> str | None: ...
    @property
    def format_version(self) -> str: ...
    @property
    def writer_version(self) -> str: ...
    @property
    def protocol_version(self) -> str | None: ...
    @property
    def refs(self) -> list[str]: ...
