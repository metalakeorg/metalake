    "/api/v1/sql": {
      "post": {
        "tags": [
          "sql"
        ],
        "summary": "Runs statements on the lake, as `metalake sql` and Python's `lake.sql` do, through the same session: a read at the\npoint it is run, a write committed. The rows of the last statement come as an Arrow IPC stream, so that each value\nkeeps its type, and at most as many as asked: a statement that answered more says so. A request the browser drops\ndrops the statement, which stops reading.",
        "operationId": "sql",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Statement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The first rows of the last statement",
            "headers": {
              "metalake-rows": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "description": "How many rows it holds"
              },
              "metalake-truncated": {
                "schema": {
                  "type": "boolean"
                },
                "description": "Whether the statement answered more"
              }
            },
            "content": {
              "application/vnd.apache.arrow.stream": {}
            }
          },
          "400": {
            "description": "A statement that is wrong, or refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "403": {
            "description": "From another origin than the UI's own",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "409": {
            "description": "A write that conflicts with another; nothing changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The statement failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "lake"
        ],
        "summary": "What the lake is: its catalog, its warehouse, its versions and its refs.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "What the lake is",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "502": {
            "description": "The connection to its Postgres was lost",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "The API's version.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "The API's version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Column": {
        "type": "object",
        "description": "A column of a table, nested ones included.",
        "required": [
          "id",
          "name",
          "type",
          "required"
        ],
        "properties": {
          "default": {
            "description": "What a write that names it not gives it."
          },
          "doc": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The column it is a field of, for a nested one."
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "description": "Its type, as Iceberg writes it."
          }
        }
      },
      "Commit": {
        "type": "object",
        "description": "A commit of a ref.",
        "required": [
          "seq",
          "operation"
        ],
        "properties": {
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "committed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "type": "string",
            "description": "What it did: `append`, `update`, `merge`, `branch`…"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Fault": {
        "type": "object",
        "description": "A failure, as the command line's `--format json` says it.",
        "required": [
          "kind",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Postgres's SQLSTATE."
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether the same request may succeed if made again."
          },
          "rule": {
            "type": [
              "string",
              "null"
            ],
            "description": "The specification's rule a refused write broke."
          }
        }
      },
      "IcebergState": {
        "type": "object",
        "description": "Where a table's Iceberg metadata stands, for a table set to write it on commit.",
        "required": [
          "behind"
        ],
        "properties": {
          "behind": {
            "type": "integer",
            "format": "int64",
            "description": "Its commits that metadata does not serve yet."
          },
          "head": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The table's latest snapshot on the ref."
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ],
            "description": "The latest metadata file."
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the first of those was committed."
          },
          "written": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The sequence its latest metadata file serves."
          }
        }
      },
      "Kind": {
        "type": "string",
        "description": "What a failure means to whoever called, as the command line's exit codes and Python's exceptions say it.",
        "enum": [
          "usage",
          "failed",
          "conflict",
          "unknown"
        ]
      },
      "Mark": {
        "type": "object",
        "description": "The lake's state, as far as telling that it changed needs: when either moves, what is shown of it is read again.",
        "required": [
          "seq",
          "recent",
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "integer",
            "format": "int64",
            "description": "How many refs were deleted."
          },
          "recent": {
            "type": "integer",
            "format": "int64",
            "description": "How many commits it has among its latest sequences: one that lands after a later one moves it."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Its latest commit's sequence: a commit, a merge and a new ref each move it."
          }
        }
      },
      "Named": {
        "type": "object",
        "description": "A ref, by its name and its kind.",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "`branch` or `tag`."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Notebook": {
        "type": "object",
        "description": "Whether this `metalake` can give a Notebook (ADR 0008).",
        "required": [
          "python",
          "jupyterlab",
          "running",
          "install"
        ],
        "properties": {
          "install": {
            "type": "string",
            "description": "The line that installs what the Notebook needs into that Python."
          },
          "jupyterlab": {
            "type": "boolean",
            "description": "Whether that Python imports JupyterLab and the kernel."
          },
          "open": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the page opens it while it runs: its path, with its token once."
          },
          "python": {
            "type": "boolean",
            "description": "Whether it runs in a Python: a `metalake` pip installed does, one built alone does not."
          },
          "running": {
            "type": "boolean",
            "description": "Whether the UI's JupyterLab runs now."
          }
        }
      },
      "Ref": {
        "type": "object",
        "description": "A branch or a tag.",
        "required": [
          "name",
          "kind",
          "created_seq",
          "protected"
        ],
        "properties": {
          "created_seq": {
            "type": "integer",
            "format": "int64",
            "description": "The sequence it was made at."
          },
          "fork_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The sequence of its parent it was made at."
          },
          "kind": {
            "type": "string",
            "description": "`branch` or `tag`."
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ref it was made from, if any: `main` has none."
          },
          "protected": {
            "type": "boolean",
            "description": "Whether it may be deleted."
          }
        }
      },
      "RefDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Ref"
          },
          {
            "type": "object",
            "required": [
              "size",
              "schemas"
            ],
            "properties": {
              "schemas": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SchemaSummary"
                }
              },
              "size": {
                "$ref": "#/components/schemas/Size"
              },
              "warehouse": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Where the lake's files are."
              }
            }
          }
        ],
        "description": "A ref, what it holds, and its schemas, as the Catalog's view of it shows them."
      },
      "SchemaDetails": {
        "type": "object",
        "description": "A schema, its properties, and its tables.",
        "required": [
          "name",
          "properties",
          "size",
          "tables"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "size": {
            "$ref": "#/components/schemas/Size"
          },
          "tables": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TableSummary"
            }
          }
        }
      },
      "SchemaSummary": {
        "type": "object",
        "description": "A schema, by its levels joined by dots, and what it holds.",
        "required": [
          "name",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "$ref": "#/components/schemas/Size"
          }
        }
      },
      "Size": {
        "type": "object",
        "description": "How much something holds: its tables, their rows, and their bytes.",
        "required": [
          "tables",
          "rows",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "rows": {
            "type": "integer",
            "format": "int64"
          },
          "tables": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "description": "A snapshot of a table on a ref: the table as a commit left it.",
        "required": [
          "id"
        ],
        "properties": {
          "committed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "operation": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "Statement": {
        "type": "object",
        "description": "What to run: a text of statements, in order, each committed before the next, as `metalake sql` runs one.",
        "required": [
          "sql"
        ],
        "properties": {
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "The branch a name that says no ref reads and writes on: `default.t` is `dev.default.t` on `dev`. By default,\n`main`."
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "How many rows of the last statement to answer, at most [`MOST`]; by default [`LIMIT`].",
            "minimum": 0
          },
          "sql": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "description": "What the lake is, as `metalake status` says it.",
        "required": [
          "schema",
          "format_version",
          "writer_version",
          "refs"
        ],
        "properties": {
          "format_version": {
            "type": "string"
          },
          "local": {
            "type": [
              "string",
              "null"
            ],
            "description": "The directory of the lake's own Postgres; absent for a lake on another."
          },
          "postgres": {
            "type": [
              "string",
              "null"
            ],
            "description": "The catalog's Postgres, without its password; absent for a lake with its own."
          },
          "protocol_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Named"
            },
            "description": "Every branch and tag."
          },
          "schema": {
            "type": "string",
            "description": "The catalog's schema in that Postgres."
          },
          "warehouse": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the lake's files are."
          },
          "writer_version": {
            "type": "string"
          }
        }
      },
      "Table": {
        "type": "object",
        "description": "A table of the catalog, by its namespace's parts and its name.",
        "required": [
          "namespace",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TableDetails": {
        "type": "object",
        "description": "A table: what it is, how it is laid out, how much it holds, and where its Iceberg metadata stands.",
        "required": [
          "namespace",
          "name",
          "id",
          "location",
          "columns",
          "rows",
          "bytes",
          "files",
          "inline_files",
          "deleted_rows",
          "cluster_key",
          "properties"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "cluster_key": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The columns whose statistics are indexed for pruning."
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Column"
            }
          },
          "deleted_rows": {
            "type": "integer",
            "format": "int64"
          },
          "files": {
            "type": "integer",
            "format": "int64",
            "description": "Its files stored in the warehouse."
          },
          "iceberg": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/IcebergState"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "inline_files": {
            "type": "integer",
            "format": "int64",
            "description": "Its files kept in the catalog itself, until they are flushed."
          },
          "location": {
            "type": "string",
            "description": "The prefix its files are written under."
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "partition": {
            "description": "Its default partition spec, as Iceberg writes one."
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "rows": {
            "type": "integer",
            "format": "int64",
            "description": "Its rows: those of its files, less those their deletion vectors delete."
          },
          "sort_order": {
            "description": "Its default sort order, as Iceberg writes one."
          }
        }
      },
      "TableSummary": {
        "type": "object",
        "description": "A table of a schema: what it holds, and when it last changed.",
        "required": [
          "name",
          "rows",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "changed_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When its latest snapshot on the ref was committed."
          },
          "name": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "The API's version.",
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "type": "integer",
            "format": "int32",
            "description": "[`VERSION`]: a frontend built for another refuses this server.",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ]
}
