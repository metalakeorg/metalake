{
  "openapi": "3.1.0",
  "info": {
    "title": "MetaLake UI",
    "description": "The API of `metalake ui` (ADR 0007 §4.1)",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/events": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "The lake's marks as it changes, as server-sent events: a `mark` now, then one each time the lake's differs, for as\nlong as the request is open. A `fault` ends them; the frontend asks again.",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "Events `mark`, and a last `fault` if one comes",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Mark"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be watched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Every branch and tag.",
        "operationId": "refs",
        "responses": {
          "200": {
            "description": "Every branch and tag",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ref"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}/tables": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "The tables a ref sees at its head.",
        "operationId": "tables",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Its tables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "400": {
            "description": "No such ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "lake"
        ],
        "summary": "What the lake is: its catalog, its warehouse, its versions and its refs.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "What the lake is",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "502": {
            "description": "The connection to its Postgres was lost",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "The API's version.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "The API's version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Fault": {
        "type": "object",
        "description": "A failure, as the command line's `--format json` says it.",
        "required": [
          "kind",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Postgres's SQLSTATE."
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether the same request may succeed if made again."
          },
          "rule": {
            "type": [
              "string",
              "null"
            ],
            "description": "The specification's rule a refused write broke."
          }
        }
      },
      "Kind": {
        "type": "string",
        "description": "What a failure means to whoever called, as the command line's exit codes and Python's exceptions say it.",
        "enum": [
          "usage",
          "failed",
          "conflict",
          "unknown"
        ]
      },
      "Mark": {
        "type": "object",
        "description": "The lake's state, as far as telling that it changed needs: when either moves, what is shown of it is read again.",
        "required": [
          "seq",
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "integer",
            "format": "int64",
            "description": "How many refs were deleted."
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "description": "Its latest commit's sequence: a commit, a merge and a new ref each move it."
          }
        }
      },
      "Named": {
        "type": "object",
        "description": "A ref, by its name and its kind.",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "`branch` or `tag`."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Ref": {
        "type": "object",
        "description": "A branch or a tag.",
        "required": [
          "name",
          "kind",
          "created_seq",
          "protected"
        ],
        "properties": {
          "created_seq": {
            "type": "integer",
            "format": "int64",
            "description": "The sequence it was made at."
          },
          "fork_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The sequence of its parent it was made at."
          },
          "kind": {
            "type": "string",
            "description": "`branch` or `tag`."
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ref it was made from, if any: `main` has none."
          },
          "protected": {
            "type": "boolean",
            "description": "Whether it may be deleted."
          }
        }
      },
      "Status": {
        "type": "object",
        "description": "What the lake is, as `metalake status` says it.",
        "required": [
          "schema",
          "format_version",
          "writer_version",
          "refs"
        ],
        "properties": {
          "format_version": {
            "type": "string"
          },
          "local": {
            "type": [
              "string",
              "null"
            ],
            "description": "The directory of the lake's own Postgres; absent for a lake on another."
          },
          "postgres": {
            "type": [
              "string",
              "null"
            ],
            "description": "The catalog's Postgres, without its password; absent for a lake with its own."
          },
          "protocol_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Named"
            },
            "description": "Every branch and tag."
          },
          "schema": {
            "type": "string",
            "description": "The catalog's schema in that Postgres."
          },
          "warehouse": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the lake's files are."
          },
          "writer_version": {
            "type": "string"
          }
        }
      },
      "Table": {
        "type": "object",
        "description": "A table of the catalog, by its namespace's parts and its name.",
        "required": [
          "namespace",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "The API's version.",
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "type": "integer",
            "format": "int32",
            "description": "[`VERSION`]: a frontend built for another refuses this server.",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ]
}
