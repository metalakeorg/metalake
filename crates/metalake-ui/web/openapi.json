{
  "openapi": "3.1.0",
  "info": {
    "title": "MetaLake UI",
    "description": "The API of `metalake ui` (ADR 0007 §4.1)",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/events": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "The lake's marks as it changes, as server-sent events: a `mark` now, then one each time the lake's differs, for as\nlong as the request is open. A `fault` ends them; the frontend asks again.",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "Events `mark`, and a last `fault` if one comes",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Mark"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be watched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notebook": {
      "get": {
        "tags": [
          "notebook"
        ],
        "summary": "Whether this `metalake` can give a Notebook: a Python, and JupyterLab in it; and the line that installs it. Looked\nat each time, so that an install while the UI runs is seen.",
        "operationId": "notebook_state",
        "responses": {
          "200": {
            "description": "What the Notebook can do here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notebook"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notebook/start": {
      "post": {
        "tags": [
          "notebook"
        ],
        "summary": "Starts the UI's JupyterLab, unless it runs already, and answers once it serves; what the Notebook can do then.",
        "operationId": "notebook_start",
        "responses": {
          "200": {
            "description": "JupyterLab serves",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notebook"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "403": {
            "description": "From another origin than the UI's own",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "JupyterLab did not start, with why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Every branch and tag.",
        "operationId": "refs",
        "responses": {
          "200": {
            "description": "Every branch and tag",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ref"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A ref: what it is, what it holds, and its schemas, each with what it holds.",
        "operationId": "ref_details",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefDetails"
                }
              }
            }
          },
          "400": {
            "description": "No such ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}/commits": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A ref's commits, the latest first.",
        "operationId": "commits",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "How many, the latest first: 50 when absent, 1,000 at most.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Its commits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Commit"
                  }
                }
              }
            }
          },
          "400": {
            "description": "No such ref, or a limit out of bounds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}/schemas/{schema}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A schema of a ref, by its levels joined by dots: its properties, and its tables, each with what it holds.",
        "operationId": "schema_details",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schema",
            "in": "path",
            "description": "The schema, its levels joined by dots",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaDetails"
                }
              }
            }
          },
          "400": {
            "description": "No such ref or schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}/tables": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "The tables a ref sees at its head.",
        "operationId": "tables",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Its tables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "400": {
            "description": "No such ref",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}/tables/{schema}/{table}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A table of a ref: its columns, its layout, how much it holds, and its Iceberg metadata.",
        "operationId": "table_details",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schema",
            "in": "path",
            "description": "The table's schema, its levels joined by dots",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "description": "The table's name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableDetails"
                }
              }
            }
          },
          "400": {
            "description": "No such ref or table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "401": {
            "description": "Without the run's token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          },
          "500": {
            "description": "The lake could not be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fault"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refs/{ref}/tables/{schema}/{table}/snapshots": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A table's snapshots on a ref, the latest first.",
        "operationId": "snapshots",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "description": "The branch or tag, percent-encoded",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schema",
            "in": "path",
            "description": "The table's schema, its levels joined by dots",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "path",
            "description": "The table's name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "How many, the latest first: 50 when absent, 1,000 at most.",
