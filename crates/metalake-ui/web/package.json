    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.24",
    "@uwdata/flechette": "^2.7.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
