{
  "name": "@metalake/jupyterlab-ref",
  "description": "The Notebook's ref selector (ADR 0008 §6): the ref a notebook reads and writes on, kept in it",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "style/**/*.css"
  ],
  "style": "style/index.css",
  "sideEffects": [
    "style/*.css"
  ],
  "scripts": {
    "build": "tsc && jupyter-builder build .",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.0",
    "@jupyterlab/apputils": "^4.7.0",
    "@jupyterlab/docregistry": "^4.6.0",
    "@jupyterlab/notebook": "^4.6.0",
    "@jupyterlab/services": "^7.6.0",
    "@lumino/disposable": "^2.1.0",
    "@lumino/widgets": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "@jupyterlab/builder": "^4.5.0",
    "typescript": "~5.9.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../web/dist/labextension"
  }
}
