<?xml version="1.0"?>
<!-- DataNodes are reached by their names, `127.0.0.1` here, the ports the cluster publishes, not by the addresses
     they have inside Docker's network, which the host cannot reach. -->
<configuration>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
</configuration>
