<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache Iceberg's REST Compatibility Kit, from the jars Iceberg publishes, with what they need beside them: their POM
  declares nothing, so this does. It builds nothing; `mvn dependency:copy-dependencies` gathers the classpath that the
  JUnit console runs the kit with (.github/workflows/iceberg-rck.yml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.metalake.ci</groupId>
  <artifactId>rck</artifactId>
  <version>0</version>
  <packaging>pom</packaging>

  <properties>
    <iceberg>1.11.0</iceberg>
    <hadoop>3.4.1</hadoop>
    <junit-platform>1.14.4</junit-platform>
  </properties>

  <dependencies>
    <!-- The kit: its tests, and the fixtures they start from. -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-open-api</artifactId>
      <version>${iceberg}</version>
      <classifier>tests</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-open-api</artifactId>
      <version>${iceberg}</version>
      <classifier>test-fixtures</classifier>
    </dependency>
    <!-- CatalogTests, which the kit extends, and the helpers of Iceberg's own tests. -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg}</version>
      <classifier>tests</classifier>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-api</artifactId>
      <version>${iceberg}</version>
      <classifier>tests</classifier>
    </dependency>
    <!-- The client writes manifests to the table's location, here a local directory, through Hadoop. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-api</artifactId>
      <version>${hadoop}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-runtime</artifactId>
      <version>${hadoop}</version>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
    </dependency>
    <!-- What runs it: JUnit's console, with the Jupiter and Suite engines inside. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-console-standalone</artifactId>
      <version>${junit-platform}</version>
    </dependency>
  </dependencies>
</project>
